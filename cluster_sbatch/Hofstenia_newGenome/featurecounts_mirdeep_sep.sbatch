ew_groups/vaksler_group/Isana_Tzah/Charles_seq/Hofstenia_newGenome/STAR/align_to_genome/SMA1/Hofstenia_Aligned.out.sam /mnt/new_groups/vaksler_group/Isana_Tzah/Charles_seq/Hofstenia_newGenome/STAR/align_to_genome/SMA2/Hofstenia_Aligned.out.sam /mnt/new_groups/vaksler_group/Isana_Tzah/Charles_seq/Hofstenia_newGenome/STAR/align_to_genome/SMA3/Hofstenia_Aligned.out.sam
echo finished.


